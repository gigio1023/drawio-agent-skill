          <mxGeometry x="300" y="130" width="280" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="note-loop" value="Return loop owns the bottom corridor" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=11;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="300" y="430" width="240" height="20" as="geometry"/>
