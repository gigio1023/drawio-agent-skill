<mxfile host="app.diagrams.net" version="26.0.11">
  <diagram id="edge-routing-patterns" name="Edge Routing Patterns">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="heading" value="&lt;font style=&quot;font-size:10px;letter-spacing:1.4px;color:#6B7280;&quot;&gt;ROUTING SAMPLE&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:26px;font-weight:700;color:#111827;&quot;&gt;Edge routing patterns&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#4B5563;&quot;&gt;Straight main path, lane-separated request/response, corridor skip edge, bottom return loop, vertical fan-out.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="80" y="40" width="900" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="client" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;browser session" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;fontColor=#111827;fontSize=13;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="gateway" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;auth + rate limit" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.6;fontColor=#111827;fontSize=13;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="240" width="160" height="80" as="geometry"/>
        </mxCell>
