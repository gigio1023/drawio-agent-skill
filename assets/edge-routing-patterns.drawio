        </mxCell>
        <mxCell id="queue" value="&lt;b&gt;Queue&lt;/b&gt;&lt;br&gt;async events" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;fontColor=#111827;fontSize=13;spacing=10;" vertex="1" parent="1">
