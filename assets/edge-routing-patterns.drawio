        <mxCell id="note-straight" value="Aligned centers make the main path straight" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=11;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="250" y="330" width="260" height="20" as="geometry"/>
        </mxCell>
